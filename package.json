{
  "name": "food-log",
  "version": "1.0.0",
  "private": true,
  "description": "Food, water and weight tracker. Web app + Android APK via Capacitor.",
  "scripts": {
    "android:add": "cap add android",
    "android:icons": "capacitor-assets generate --android --iconBackgroundColor \"#08090D\" --iconBackgroundColorDark \"#08090D\" --splashBackgroundColor \"#08090D\" --splashBackgroundColorDark \"#08090D\"",
    "android:sync": "cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "6.1.2",
    "@capacitor/core": "6.1.2",
    "@capacitor/local-notifications": "6.1.3"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "6.1.2"
  }
}
